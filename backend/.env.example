DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Use SQLite on PythonAnywhere free accounts (new free accounts do not include MySQL)
USE_SQLITE=True

# Or if using MySQL, set USE_SQLITE=False and fill in these values:
# DB_NAME=yourusername$binzakk_db
# DB_USER=yourusername
# DB_PASSWORD=your-mysql-password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306
